---
import Base from "../../../layouts/Base.astro";
import consumables from "../../../data/consumables.json";

export function getStaticPaths() {
  const groups = [...new Set(consumables.map((c) => c.group || "Other"))];
  const slugify = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-");
  return groups.map((g) => ({
    params: { group: slugify(g) },
    props: {
      group: g,
      items: consumables.filter((c) => (c.group || "Other") === g),
    },
  }));
}

const { group, items } = Astro.props;
const title = `${group} in Sons of the Forest`;
---

<Base title={`${title} – TimberDB`} description={`All ${items.length} ${group.toLowerCase()} in Sons of the Forest: stat effects, how to obtain them and where to store each one.`}>
  <nav class="muted" style="font-size:0.9rem;margin-bottom:1rem">
    <a href="/">Home</a> › <a href="/consumables/">Consumables</a> › <span>{group}</span>
  </nav>
  <h1>{title}</h1>
  <p>{items.length} consumables in the <strong>{group}</strong> category:</p>
  <ul class="cols2">
    {items
      .sort((a, b) => a.name.localeCompare(b.name))
      .map((c) => (
        <li>
          <a href={`/consumables/${c.slug}/`}>{c.name}</a>
          {c.effects ? <span class="muted"> ({c.effects})</span> : ""}
        </li>
      ))}
  </ul>
  <p><a href="/consumables/">← Back to all consumables</a></p>
</Base>
