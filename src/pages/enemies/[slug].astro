---
import Base from "../../layouts/Base.astro";
import enemies from "../../data/enemies.json";

import Related from "../../components/Related.astro";
export function getStaticPaths() {
  return enemies.map((e) => ({
    params: { slug: e.slug },
    props: { enemy: e },
  }));
}

const { enemy } = Astro.props;
const sameGroup = enemies
  .filter((e) => e.group && enemy.group && e.group === enemy.group && e.slug !== enemy.slug)
  .slice(0, 8);
const groupSlug = (enemy.group || "other").toLowerCase().replace(/[^a-z0-9]+/g, "-");
const title = `${enemy.name} – Sons of the Forest Enemy`;
const desc =
  enemy.summary ||
  `${enemy.name} is ${/^[aeiou]/i.test(enemy.group || "") ? "an" : "a"} ${enemy.group || "enemy"} in Sons of the Forest. See health, weaknesses, drops and spawn locations.`;
---

<Base title={title} description={`Sons of the Forest ${enemy.name}: health, speed, weaknesses, what it drops and where it spawns. Combat tips included. ${desc.slice(0, 100)}`}>
  <nav class="muted" style="font-size:0.9rem;margin-bottom:1rem">
    <a href="/">Home</a> › <a href="/enemies/">Enemies</a> ›
    <a href={`/enemies/group/${groupSlug}/`}>{enemy.group || "Other"}</a> ›
    <span>{enemy.name}</span>
  </nav>
  <h1>{enemy.name}</h1>
  {enemy.alias && enemy.alias !== enemy.name && <p class="muted">Also known as: {enemy.alias}</p>}

  <div class="card" style="margin:1rem 0">
    <table>
      {enemy.group && <tr><th>Group</th><td>{enemy.group}</td></tr>}
      {enemy.klass && <tr><th>Class</th><td>{enemy.klass}</td></tr>}
      {enemy.health && <tr><th>Health</th><td><strong>{enemy.health}</strong></td></tr>}
      {enemy.damage && <tr><th>Damage</th><td>{enemy.damage}</td></tr>}
      {enemy.speed && <tr><th>Speed</th><td>{enemy.speed}</td></tr>}
      {enemy.weakness && <tr><th>Weakness</th><td>{enemy.weakness}</td></tr>}
      {enemy.drops && <tr><th>Drops</th><td>{enemy.drops}</td></tr>}
      {enemy.spawn && <tr><th>Spawns</th><td>{enemy.spawn}</td></tr>}
      {enemy.weapon && <tr><th>Weapons Used</th><td>{enemy.weapon}</td></tr>}
    </table>
  </div>

  {enemy.summary && (
    <>
      <h2>About {enemy.name}</h2>
      <p>{enemy.summary}</p>
    </>
  )}

  <p class="muted">
    How to beat {enemy.name}: aim for its {enemy.weakness || "weak points"} and use the terrain.
    Check the stats table above to pick the right weapon from our <a href="/weapons/">weapons database</a>.
  </p>

  {sameGroup.length > 0 && (
    <>
      <h2>More {enemy.group}</h2>
      <ul class="cols2">
        {sameGroup.map((e) => (
          <li><a href={`/enemies/${e.slug}/`}>{e.name}</a>{e.health ? <span class="muted"> ({e.health} HP)</span> : ""}</li>
        ))}
      </ul>
    </>
  )}

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    headline: `${enemy.name} – Sons of the Forest Enemy`,
    description: desc,
    about: { "@type": "Thing", name: enemy.name },
    isPartOf: { "@type": "WebSite", name: "TimberDB" },
  })} />


  <Related
    heading="Next steps"
    links={[

    { href: "/rankings/", title: "Rankings", sub: "Damage, hunger and energy leaders ranked", tool: true },
    { href: "/calculator/", title: "Food Planner", sub: "Build balanced meals for full health & stamina", tool: true },
  ]}
  />
</Base>
