---
import Base from "../../layouts/Base.astro";
import DataTable from "../../components/DataTable.astro";
import enemies from "../../data/enemies.json";

const rows = enemies
  .map((e) => ({
    name: e.name,
    group: e.group || "-",
    health: e.health || "-",
    speed: e.speed || "-",
    drops: e.drops || "-",
    href: `/enemies/${e.slug}/`,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const byGroup = {};
for (const e of enemies) {
  const g = e.group || "Other";
  (byGroup[g] ||= []).push(e);
}
---

<Base
  title="Sons of the Forest Enemies Database – Health, Weaknesses & Drops"
  description={`Complete list of all ${enemies.length} enemies in Sons of the Forest: cannibals and mutants with health, speed, weaknesses, drops and spawn locations.`}
>
  <nav class="muted" style="font-size:0.9rem;margin-bottom:1rem">
    <a href="/">Home</a> › <span>Enemies</span>
  </nav>
  <h1>Sons of the Forest Enemies Database</h1>
  <p>
    All <strong>{enemies.length} enemies</strong> in Sons of the Forest — cannibals, mutants and wildlife.
    Click any enemy for health, weaknesses, drops and where they spawn.
  </p>

  <div class="card" style="margin:1rem 0">
    <h2 style="margin-top:0">Browse by Group</h2>
    <ul class="cols2">
      {Object.entries(byGroup)
        .sort(([a], [b]) => a.localeCompare(b))
        .map(([g, list]) => (
          <li>
            <a href={`/enemies/group/${g.toLowerCase().replace(/[^a-z0-9]+/g, "-")}/`}>{g}</a>
            <span class="muted"> ({list.length})</span>
          </li>
        ))}
    </ul>
  </div>

  <h2>All Enemies</h2>
  <DataTable
    id="enemies"
    rows={rows}
    searchPlaceholder="Search enemies..."
    columns={[
      { key: "name", label: "Enemy", href: "href" },
      { key: "group", label: "Group" },
      { key: "health", label: "Health" },
      { key: "speed", label: "Speed" },
      { key: "drops", label: "Drops" },
    ]}
  />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Sons of the Forest Enemies Database",
    numberOfItems: enemies.length,
    itemListElement: enemies.slice(0, 30).map((e, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: e.name,
      url: `/enemies/${e.slug}/`,
    })),
  })} />
</Base>
