---
import Base from "../../layouts/Base.astro";
import DataTable from "../../components/DataTable.astro";
import weapons from "../../data/weapons.json";

const rows = weapons
  .map((w) => ({
    name: w.name,
    type: w.type || "-",
    speed: w.speed || "-",
    standard: w.damageStandard || "-",
    charged: w.damageCharged || "-",
    href: `/weapons/${w.slug}/`,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const byType = {};
for (const w of weapons) {
  const t = w.type || "Other";
  (byType[t] ||= []).push(w);
}
---

<Base
  title="Sons of the Forest Weapons Database – All Weapons with Damage Stats"
  description={`Complete list of all ${weapons.length} weapons in Sons of the Forest: melee and ranged weapons with standard, charged and downward damage, speed, range and where to find them.`}
>
  <nav class="muted" style="font-size:0.9rem;margin-bottom:1rem">
    <a href="/">Home</a> › <span>Weapons</span>
  </nav>
  <h1>Sons of the Forest Weapons Database</h1>
  <p>
    All <strong>{weapons.length} weapons</strong> in Sons of the Forest, sortable and searchable.
    Click any weapon for full damage stats, how to get it and combat tips.
  </p>

  <div class="card" style="margin:1rem 0">
    <h2 style="margin-top:0">Browse by Type</h2>
    <ul class="cols2">
      {Object.entries(byType)
        .sort(([a], [b]) => a.localeCompare(b))
        .map(([cat, list]) => (
          <li>
            <a href={`/weapons/type/${cat.toLowerCase().replace(/[^a-z0-9]+/g, "-")}/`}>{cat}</a>
            <span class="muted"> ({list.length})</span>
          </li>
        ))}
    </ul>
  </div>

  <h2>All Weapons</h2>
  <DataTable
    id="weapons"
    rows={rows}
    searchPlaceholder="Search weapons..."
    columns={[
      { key: "name", label: "Weapon", href: "href" },
      { key: "type", label: "Type" },
      { key: "speed", label: "Speed" },
      { key: "standard", label: "Std Dmg", type: "number" },
      { key: "charged", label: "Charged", type: "number" },
    ]}
  />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Sons of the Forest Weapons Database",
    numberOfItems: weapons.length,
    itemListElement: weapons.slice(0, 50).map((w, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: w.name,
      url: `/weapons/${w.slug}/`,
    })),
  })} />
</Base>
