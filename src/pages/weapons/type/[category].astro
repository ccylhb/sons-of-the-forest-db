---
import Base from "../../../layouts/Base.astro";
import DataTable from "../../../components/DataTable.astro";
import weapons from "../../../data/weapons.json";

export function getStaticPaths() {
  const cats = {};
  for (const w of weapons) {
    const t = w.type || "Other";
    (cats[t] ||= []).push(w);
  }
  return Object.entries(cats).map(([cat, list]) => ({
    params: { category: cat.toLowerCase().replace(/[^a-z0-9]+/g, "-") },
    props: { cat, list },
  }));
}

const { cat, list } = Astro.props;
const rows = list
  .map((w) => ({
    name: w.name,
    speed: w.speed || "-",
    standard: w.damageStandard || "-",
    charged: w.damageCharged || "-",
    downward: w.damageDownward || "-",
    href: `/weapons/${w.slug}/`,
  }))
  .sort((a, b) => (parseInt(b.standard) || 0) - (parseInt(a.standard) || 0) || a.name.localeCompare(b.name));
const title = `Sons of the Forest ${cat} Weapons – Complete List (${list.length})`;
---

<Base
  title={title}
  description={`All ${list.length} ${cat} weapons in Sons of the Forest with damage, speed and range stats. Sortable table, click any weapon for details.`}
>
  <nav class="muted" style="font-size:0.9rem;margin-bottom:1rem">
    <a href="/">Home</a> › <a href="/weapons/">Weapons</a> › <span>{cat}</span>
  </nav>
  <h1>Sons of the Forest {cat} Weapons</h1>
  <p>
    Complete list of all <strong>{list.length} {cat.toLowerCase()} weapons</strong>,
    sorted by standard damage. Click a weapon for full stats and where to find it.
  </p>

  <DataTable
    id={`w-${cat.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}
    rows={rows}
    searchPlaceholder={`Search ${cat.toLowerCase()} weapons...`}
    columns={[
      { key: "name", label: "Weapon", href: "href" },
      { key: "speed", label: "Speed" },
      { key: "standard", label: "Std Dmg", type: "number" },
      { key: "charged", label: "Charged", type: "number" },
      { key: "downward", label: "Downward", type: "number" },
    ]}
  />

  <p style="margin-top:1.5rem">
    <a href="/weapons/">← Back to all weapons</a>
  </p>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: `Sons of the Forest ${cat} Weapons`,
    numberOfItems: list.length,
    itemListElement: list.slice(0, 30).map((w, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: w.name,
      url: `/weapons/${w.slug}/`,
    })),
  })} />
</Base>
